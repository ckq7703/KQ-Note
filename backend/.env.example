# Copy to .env and adjust for your deployment.
DATABASE_URL=sqlite:///./notes_sync.db
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Must match the "Desktop app" OAuth client ID embedded in app/sync/google_oauth.py
GOOGLE_CLIENT_ID=379908990291-36934dgf21e8u90qj8f5ldnoij76ij1k.apps.googleusercontent.com
# OAuth client secret for that "Desktop app" client. Server-only — it is NEVER
# shipped in the desktop client or a public release. Get it from Google Cloud
# Console -> APIs & Services -> Credentials.
GOOGLE_CLIENT_SECRET=
