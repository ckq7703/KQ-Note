# Copy to .env and adjust for your deployment.
DATABASE_URL=sqlite:///./notes_sync.db
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Must match the "Desktop app" OAuth client ID embedded in app/sync/google_oauth.py
GOOGLE_CLIENT_ID=379908990291-36934dgf21e8u90qj8f5ldnoij76ij1k.apps.googleusercontent.com
# OAuth client secret for that "Desktop app" client. Server-only — it is NEVER
# shipped in the desktop client or a public release. Get it from Google Cloud
# Console -> APIs & Services -> Credentials.
GOOGLE_CLIENT_SECRET=

# --- Request guard (all optional; the defaults are generous) ---
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_API_PER_MINUTE=1200   # per access token
# RATE_LIMIT_AUTH_PER_MINUTE=120   # /auth/* per client IP (slows password guessing)
# Number of reverse proxies in front of the API. 0 = use the socket peer address. Behind a
# Cloudflare tunnel every request arrives from the connector, so the /auth limit is shared by
# all users until you set this (usually 1 after checking X-Forwarded-For carries the client IP).
# TRUSTED_PROXY_COUNT=0
# MIN_CLIENT_VERSION=1.5.0         # older desktop clients get HTTP 426 on /v2 (empty = allow all)
# LEGACY_NOTES_ENABLED=true        # false retires the one-note /notes/me API (HTTP 410)
# LEGACY_SUNSET=Wed, 31 Dec 2026 23:59:59 GMT   # optional Sunset header on the legacy API
# IMAGE_GC_GRACE_DAYS=30           # unreferenced images are deleted after this many days
