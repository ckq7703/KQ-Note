# Copy to .env (same directory as docker-compose.yml) on the server and fill in real values.
# docker-compose reads this file automatically.

POSTGRES_USER=notesync
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=notesync

JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Must match the "Desktop app" OAuth client ID embedded in app/sync/google_oauth.py
GOOGLE_CLIENT_ID=379908990291-36934dgf21e8u90qj8f5ldnoij76ij1k.apps.googleusercontent.com
# OAuth client secret for that "Desktop app" client. Server-only — it is NEVER
# shipped in the desktop client or a public release.
GOOGLE_CLIENT_SECRET=

# From Cloudflare Zero Trust dashboard -> Networks -> Tunnels -> (your tunnel) -> Install connector.
# The Public Hostname (note.smartpro.com.vn -> http://api:8000) is configured in that same
# dashboard screen, not here.
CLOUDFLARE_TUNNEL_TOKEN=
